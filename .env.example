# =============================================================================
# SAILBOAT TELEMETRY DASHBOARD - ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================

# --- AUTHENTICATION (NextAuth.js Single User) ---
# Username for skipper / father dashboard access
AUTH_USERNAME="skipper"

# Bcrypt hash of the login password. NEVER store plaintext passwords.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your_secure_password', 10))"
# Default placeholder corresponds to password: "father2024"
AUTH_PASSWORD_HASH="$2a$10$2pXKXOmvee76g5QwUFWG9OWyJymBLZqfJIE2lrdRqMFVD8YUtQZQC"

# Secret used to encrypt NextAuth JWT tokens and cookies (min 32 random characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# Base URL of the application
NEXTAUTH_URL="http://localhost:3000"


# --- IOT DEVICE AUTHENTICATION ---
# Secret API key shared between the Next.js API routes and the ESP32 firmware (x-api-key header)
DEVICE_API_KEY="replace-with-a-random-esp32-device-key-e.g-sb_sec_89df7a2b"


# --- FIREBASE / FIRESTORE (Server-side Admin SDK only) ---
# Service Account credentials downloaded from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional client-side public config placeholders
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyPlaceholderClientApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"


# --- RATE LIMITING (Upstash Redis) ---
# Optional: If not provided, an automatic sliding-window in-memory rate limiter is used locally
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"


# --- SCHEDULED WATCHDOG / CRON ---
# Optional secret for securing the /api/cron/watchdog Dead Man's Switch endpoint on Vercel
CRON_SECRET="your-scheduled-cron-bearer-token"
